# `make env` copies this file to .env and fills in fresh random secrets
# (scripts/make_env.sh). The services refuse to start without JWT_SECRET.
# Never commit .env: git ignores it.
JWT_SECRET=
JWT_TTL_MINUTES=60

# Gateway: requests per user per minute, by plan, and the largest request
# body it accepts (1 MiB).
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=300
MAX_BODY_BYTES=1048576

# AI provider for reviews:
#   fake       canned reviews, no API key needed (default, also used by CI)
#   anthropic  real reviews from Claude; set ANTHROPIC_API_KEY below
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
REVIEW_EFFORT=high
# Hard limit for one review, so no stream can run (and bill) forever.
REVIEW_TIMEOUT_SECONDS=600

# GitHub integration (README.md, "Review pull requests on GitHub").
# The secret GitHub signs webhooks with; `make env` fills in a random one.
# Empty turns webhooks off.
GITHUB_WEBHOOK_SECRET=
# Only pull requests in repositories owned by these GitHub accounts are
# reviewed (comma-separated logins). Empty means none.
GITHUB_ALLOWED_ACCOUNTS=
# Your GitHub App: its App ID, and its private key saved in ./secrets.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# Reviews per installation per day, a cap on cost.
MAX_REVIEWS_PER_DAY=50
# Code embeddings for the related-code search:
#   local   feature hashing, runs here, no API key needed (default)
#   voyage  Voyage AI's code model, better results; set VOYAGE_API_KEY
EMBEDDINGS_PROVIDER=local
VOYAGE_API_KEY=
