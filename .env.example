# Copy to .env with a fresh secret (the services refuse to start without one):
#   sed "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 32)/" .env.example > .env
JWT_SECRET=
JWT_TTL_MINUTES=60

# Gateway: requests per user per minute, by plan, and the largest request
# body it accepts (1 MiB).
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=300
MAX_BODY_BYTES=1048576

# AI provider for reviews:
#   fake       canned reviews, no API key needed (default, also used by CI)
#   anthropic  real reviews from Claude; set ANTHROPIC_API_KEY below
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
REVIEW_EFFORT=high
# Hard limit for one review, so no stream can run (and bill) forever.
REVIEW_TIMEOUT_SECONDS=600
