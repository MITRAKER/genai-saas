# Copy to .env and change the secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL_MINUTES=60
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=300

# AI provider for reviews:
#   fake       canned reviews, no API key needed (default, also used by CI)
#   anthropic  real reviews from Claude; set ANTHROPIC_API_KEY below
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
REVIEW_EFFORT=high
